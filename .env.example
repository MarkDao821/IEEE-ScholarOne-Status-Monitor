NOTIFY_PROVIDER=wechat

# WeChat notification providers: serverchan or pushplus.
WECHAT_PROVIDER=serverchan
WECHAT_TOKEN=

# Email notification provider. For Gmail, use an app password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

RUN_MODE=normal
HEADLESS=true
STATUS_PATH=data/status.json
LOG_DIR=logs
BROWSER_PROFILE_DIR=data/browser-profile
CHALLENGE_TIMEOUT_SECONDS=180
JOURNALS_FILE=journals.toml

# Example journal credentials referenced by journals.toml.
TCYB_USERNAME=
TCYB_PASSWORD=
